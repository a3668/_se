{
  "name": "hw2-local-login",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "dev": "node --env-file-if-exists=.dev.vars ./node_modules/@react-router/dev/bin.js dev",
    "start": "node --env-file-if-exists=.dev.vars ./node_modules/@react-router/serve/bin.js build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
